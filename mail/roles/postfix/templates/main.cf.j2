compatibility_level = 3.10

myhostname = {{ mail_hostname }}
myorigin = {{ mail_origin }}
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

message_size_limit = {{ mail_message_size_limit }}
mailbox_size_limit = 0
maximal_queue_lifetime = {{ mail_queue_lifetime }}
bounce_queue_lifetime = {{ mail_queue_lifetime }}

virtual_mailbox_domains = {{ mail_domains | join(' ') }}
virtual_mailbox_maps = lmdb:/etc/postfix/vmailbox
virtual_alias_maps = lmdb:/etc/postfix/valias
virtual_transport = lmtp:unix:private/dovecot-lmtp

smtpd_tls_cert_file = {{ mail_cert_dir }}/fullchain.pem
smtpd_tls_key_file = {{ mail_cert_dir }}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1

smtp_tls_security_level = dane
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
smtp_dns_support_level = dnssec
smtp_helo_name = $myhostname

smtpd_helo_required = yes
strict_rfc821_envelopes = yes
disable_vrfy_command = yes
smtpd_sasl_auth_enable = no

smtpd_relay_restrictions =
    permit_mynetworks
    permit_sasl_authenticated
    reject_unauth_destination
smtpd_recipient_restrictions =
    permit_mynetworks
    permit_sasl_authenticated
    reject_unknown_recipient_domain
    reject_unauth_destination
smtpd_data_restrictions = reject_unauth_pipelining

smtpd_client_connection_count_limit = {{ mail_client_connection_count_limit }}
smtpd_client_connection_rate_limit = {{ mail_client_connection_rate_limit }}
smtpd_client_message_rate_limit = {{ mail_client_message_rate_limit }}
smtpd_client_recipient_rate_limit = {{ mail_client_recipient_rate_limit }}
smtpd_client_auth_rate_limit = {{ mail_client_auth_rate_limit }}

smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = tempfail
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

postscreen_cache_map = lmdb:$data_directory/postscreen_cache
address_verify_map = lmdb:$data_directory/verify_cache

postscreen_access_list = permit_mynetworks
postscreen_greet_action = enforce
postscreen_dnsbl_threshold = {{ mail_dnsbl_threshold }}
postscreen_dnsbl_allowlist_threshold = {{ mail_dnsbl_allowlist_threshold }}
postscreen_dnsbl_action = enforce
postscreen_dnsbl_sites = {{ mail_dnsbl_sites | join(' ') }}
