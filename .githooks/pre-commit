#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --quiet -- '*.py' pyproject.toml uv.lock; then
  uv run ruff check .
  uv run ruff format --check .
fi

if ! git diff --cached --quiet -- ansible; then
  (cd ansible && uv run ansible-lint)
fi

if ! git diff --cached --quiet -- ansible/templates ansible/group_vars ansible/roles/caddy; then
  uv run python scripts/caddyfile.py
fi
