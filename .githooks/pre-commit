#!/bin/sh
set -e

if git diff --cached --quiet -- ansible; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)/ansible"
if [ -x .venv/bin/ansible-lint ]; then
  # On PATH rather than exec'd by path, or ansible-lint warns about the inactive venv.
  PATH="$PWD/.venv/bin:$PATH"
  export PATH
  exec ansible-lint
fi
exec uv run ansible-lint
